{
  "name": "design-system-extractor",
  "version": "0.0.1",
  "private": true,
  "description": "Extract a design system (colors, typography, spacing) from any website URL.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:extension": "node esbuild.extension.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "culori": "^4.0.1",
    "express": "^5.2.1",
    "node-html-parser": "^9.0.0",
    "playwright": "^1.47.0",
    "postcss": "^8.5.23",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/culori": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
